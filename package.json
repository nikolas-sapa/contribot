{
  "name": "contribot",
  "version": "0.1.0",
  "description": "An agent that onboards onto any OSS repo, understands it, and makes meaningful contributions — with hard etiquette limits so it can never act like a bot.",
  "type": "module",
  "bin": {
    "contribot": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "^13.1.0",
    "simple-git": "^3.28.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
